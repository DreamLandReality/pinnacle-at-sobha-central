{
    "templateId": "heights-luxury",
    "version": "1.0.0",
    "assetStorage": {
        "type": "r2",
        "bucket": "template-assets",
        "prefix": "templates/heights-luxury"
    },
    "collections": [],
    "pages": [
        {
            "id": "home",
            "path": "/",
            "name": "Home",
            "required": true,
            "sections": [
                "hero",
                "introduction",
                "media-showcase",
                "price-unlock",
                "brochure",
                "amenities",
                "testimonials",
                "contact-form"
            ]
        },
        {
            "id": "404",
            "path": "/404",
            "name": "404 Error",
            "required": true,
            "sections": [
                "error-page"
            ]
        }
    ],
    "globalSections": [
        "navigation",
        "footer",
        "seo"
    ],
    "sections": [
        {
            "id": "navigation",
            "name": "Navigation Bar",
            "description": "Top navigation with logo and links.",
            "required": true,
            "enabled": true,
            "imageSlots": [
                "logoImageUrl"
            ],
            "schema": {
                "type": "object",
                "required": [
                    "logoText"
                ],
                "properties": {
                    "logoText": {
                        "type": "string",
                        "uiLabel": "Logo Text",
                        "uiSection": "content"
                    },
                    "logoImageUrl": {
                        "type": "string",
                        "uiLabel": "Logo Image",
                        "uiWidget": "imageUpload",
                        "uiSection": "media"
                    },
                    "links": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "label": {
                                    "type": "string",
                                    "uiLabel": "Link Label"
                                }
                            }
                        },
                        "uiLabel": "Navigation Links",
                        "uiWidget": "repeater",
                        "uiSection": "content"
                    }
                }
            },
            "dataType": "object",
            "data": {
                "logoText": "HEIGHTS",
                "logoImageUrl": "",
                "links": [
                    {
                        "label": "Overview",
                        "href": "#hero"
                    },
                    {
                        "label": "Virtual Tour",
                        "href": "#media-showcase"
                    },
                    {
                        "label": "Pricing",
                        "href": "#price-unlock"
                    },
                    {
                        "label": "Amenities",
                        "href": "#amenities"
                    }
                ]
            }
        },
        {
            "id": "seo",
            "name": "SEO & Meta",
            "description": "Meta tags, page title, and structured data.",
            "required": true,
            "enabled": true,
            "schema": {
                "type": "object",
                "required": [
                    "title",
                    "description"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "uiLabel": "Page Title",
                        "uiSection": "content",
                        "aiHint": "Concise page title under 60 chars: property type + location + key feature"
                    },
                    "description": {
                        "type": "string",
                        "uiLabel": "Meta Description",
                        "uiWidget": "textarea",
                        "uiSection": "content",
                        "aiHint": "Compelling summary 120-155 chars with price and top amenities"
                    },
                    "language": {
                        "type": "string",
                        "uiLabel": "Language",
                        "uiSection": "settings",
                        "aiHint": "ISO 639-1 language code (e.g. en, hi, ar)"
                    },
                    "image": {
                        "type": "string",
                        "uiLabel": "Social Share Image",
                        "uiWidget": "imageUpload",
                        "uiSection": "media"
                    }
                }
            },
            "imageSlots": [
                "image"
            ],
            "dataType": "object",
            "data": {
                "title": "The Heights Country Club & Wellness | Emaar",
                "description": "Discover The Heights Country Club & Wellness \u2014 an exclusive sanctuary of refined living by Emaar, where green landscapes form a vibrant and sustainable community.",
                "language": "en",
                "image": ""
            }
        },
        {
            "id": "hero",
            "name": "Hero Section",
            "description": "Full-screen hero with headline, subtext, and background media.",
            "required": true,
            "enabled": true,
            "imageSlots": [
                "backgroundImage",
                "src"
            ],
            "schema": {
                "type": "object",
                "required": [
                    "headline"
                ],
                "properties": {
                    "heroMediaType": {
                        "type": "string",
                        "uiLabel": "Media Type",
                        "uiWidget": "select",
                        "uiSection": "media",
                        "options": [
                            {
                                "value": "image",
                                "label": "Single Image"
                            },
                            {
                                "value": "carousel",
                                "label": "Carousel"
                            },
                            {
                                "value": "video",
                                "label": "Video"
                            }
                        ],
                        "uiOrder": 10
                    },
                    "headline": {
                        "type": "string",
                        "uiLabel": "Headline",
                        "uiSection": "content"
                    },
                    "headlineItalic": {
                        "type": "string",
                        "uiLabel": "Headline Italic Part",
                        "uiSection": "content"
                    },
                    "subtext": {
                        "type": "string",
                        "uiLabel": "Subtext",
                        "uiWidget": "textarea",
                        "uiSection": "content"
                    },
                    "backgroundImage": {
                        "type": "string",
                        "uiLabel": "Background Image",
                        "uiWidget": "imageUpload",
                        "uiShowWhen": {
                            "sibling": "heroMediaType",
                            "value": "image"
                        }
                    },
                    "backgroundImageAlt": {
                        "type": "string",
                        "uiLabel": "Background Image Alt Text",
                        "uiShowWhen": {
                            "sibling": "heroMediaType",
                            "value": "image"
                        }
                    },
                    "backgroundImageCarousel": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "src": {
                                    "type": "string",
                                    "uiLabel": "Image",
                                    "uiWidget": "imageUpload"
                                },
                                "alt": {
                                    "type": "string",
                                    "uiLabel": "Alt Text"
                                }
                            }
                        },
                        "uiLabel": "Carousel Images",
                        "uiWidget": "repeater",
                        "constraints": {
                            "minItems": 2,
                            "maxItems": 10,
                            "canAdd": true,
                            "canRemove": true
                        },
                        "uiShowWhen": {
                            "sibling": "heroMediaType",
                            "value": "carousel"
                        }
                    },
                    "heroVideo": {
                        "type": "string",
                        "uiLabel": "Background Video",
                        "uiWidget": "fileUpload",
                        "uiShowWhen": {
                            "sibling": "heroMediaType",
                            "value": "video"
                        }
                    },
                    "scrollLabel": {
                        "type": "string",
                        "uiLabel": "Scroll Indicator Label",
                        "uiSection": "content"
                    },
                    "mobileLayout": {
                        "type": "string",
                        "uiLabel": "Mobile Layout",
                        "uiWidget": "select",
                        "uiSection": "layout",
                        "options": [
                            { "value": "fullscreen", "label": "Full Screen" },
                            { "value": "auto", "label": "Auto (Content Height)" }
                        ]
                    },
                    "overlayEnabled": {
                        "type": "boolean",
                        "uiLabel": "Enable Overlay",
                        "description": "Dark overlay on hero background for text readability",
                        "uiSection": "layout"
                    }
                }
            },
            "styleControls": {
                "fields": {
                    "headline": [
                        {
                            "type": "slider",
                            "property": "fontSize",
                            "label": "Size",
                            "responsive": true,
                            "min": 2,
                            "max": 6,
                            "step": 0.25,
                            "unit": "rem",
                            "default": "3.5rem"
                        },
                        {
                            "type": "buttonGroup",
                            "property": "fontWeight",
                            "label": "Weight",
                            "options": [
                                { "value": "300", "label": "Light" },
                                { "value": "400", "label": "Regular" },
                                { "value": "600", "label": "Semi" }
                            ],
                            "default": "300"
                        },
                        {
                            "type": "colorGrid",
                            "property": "color",
                            "label": "Text Color",
                            "presets": [
                                { "value": "#ffffff", "label": "White" },
                                { "value": "#e7e5e4", "label": "Light" },
                                { "value": "#1c1917", "label": "Dark" }
                            ],
                            "default": "#ffffff"
                        }
                    ],
                    "subtext": [
                        {
                            "type": "slider",
                            "property": "fontSize",
                            "label": "Size",
                            "responsive": true,
                            "min": 0.75,
                            "max": 1.5,
                            "step": 0.125,
                            "unit": "rem",
                            "default": "1rem"
                        },
                        {
                            "type": "colorGrid",
                            "property": "color",
                            "label": "Text Color",
                            "presets": [
                                { "value": "rgba(255,255,255,0.8)", "label": "White" },
                                { "value": "rgba(255,255,255,0.5)", "label": "Muted" },
                                { "value": "#1c1917", "label": "Dark" }
                            ],
                            "default": "rgba(255,255,255,0.8)"
                        }
                    ]
                }
            },
            "dataType": "object",
            "data": {
                "heroMediaType": "image",
                "headline": "A Sanctuary of",
                "headlineItalic": "Refined Living",
                "subtext": "Envisioned as an exclusive retreat lifestyle, where green landscapes come together to form a vibrant and sustainable community.",
                "backgroundImage": "defaults/default-hero.jpg",
                "backgroundImageAlt": "The Heights exterior view",
                "backgroundImageCarousel": [
                    {
                        "src": "defaults/default-hero.jpg",
                        "alt": "The Heights exterior view"
                    },
                    {
                        "src": "defaults/default-secondary.jpg",
                        "alt": "Interior living space"
                    },
                    {
                        "src": "defaults/default-hero.jpg",
                        "alt": "Landscape and amenities"
                    }
                ],
                "heroVideo": "defaults/demo-video.mp4",
                "scrollLabel": "Scroll to explore",
                "mobileLayout": "fullscreen",
                "overlayEnabled": true
            }
        },
